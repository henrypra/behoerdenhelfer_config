{
  "schema": 1,
  "benefits": [
    {
      "id": "kindergeld",
      "name": "Kindergeld (child benefit)",
      "what": "For every child, regardless of income, until at least 18.",
      "authorityId": "familienkasse",
      "apply": "app",
      "formId": "KINDERGELD",
      "deadline": "Only 6 months retroactively – apply soon.",
      "documents": [
        "TAX_ID",
        "BIRTH_CERTIFICATE",
        "BANK_DETAILS"
      ]
    },
    {
      "id": "elterngeld",
      "name": "Elterngeld (parental benefit)",
      "what": "Replaces part of your income if you work less or not at all after the birth.",
      "authorityId": "elterngeldstelle",
      "apply": "online",
      "portalUrl": "https://www.elterngeld-digital.de",
      "deadline": "Only 3 months retroactively.",
      "documents": [
        "BIRTH_CERTIFICATE",
        "INCOME_PROOF",
        "MATERNITY_CERTIFICATE",
        "BANK_DETAILS"
      ]
    },
    {
      "id": "kiz",
      "name": "Kinderzuschlag (child supplement)",
      "what": "For families with their own income that just isn't enough. Often missed.",
      "authorityId": "familienkasse",
      "apply": "online",
      "portalUrl": "https://www.arbeitsagentur.de/familie-und-kinder",
      "documents": [
        "INCOME_PROOF",
        "RENTAL_CONTRACT",
        "BANK_DETAILS"
      ]
    },
    {
      "id": "bg_ha",
      "name": "Bürgergeld – first application",
      "what": "Covers living costs and rent when income and assets are not enough.",
      "authorityId": "jobcenter",
      "apply": "app",
      "formId": "BUERGERGELD_HA",
      "deadline": "Starts in the month the Jobcenter receives it – submit now, hand in documents later.",
      "documents": [
        "ID_CARD",
        "REGISTRATION_CERTIFICATE",
        "RENTAL_CONTRACT",
        "BANK_STATEMENTS",
        "INCOME_PROOF"
      ]
    },
    {
      "id": "bg_wba",
      "name": "Bürgergeld – renewal",
      "what": "So payments don't stop when the approval period ends.",
      "authorityId": "jobcenter",
      "apply": "app",
      "formId": "BUERGERGELD_WBA",
      "deadline": "A few weeks before the approval period ends.",
      "documents": [
        "BANK_STATEMENTS",
        "INCOME_PROOF"
      ]
    },
    {
      "id": "bg_ek",
      "name": "Report a change (income / housing)",
      "what": "Mandatory while receiving benefits. Form EK for income, KDU for housing.",
      "authorityId": "jobcenter",
      "apply": "app",
      "formId": "BUERGERGELD_EK",
      "deadline": "Immediately when something changes.",
      "documents": [
        "INCOME_PROOF"
      ]
    },
    {
      "id": "kdu",
      "name": "Housing costs at the Jobcenter (form KDU)",
      "what": "Report new rent. Before moving, get the Jobcenter's written assurance.",
      "authorityId": "jobcenter",
      "apply": "app",
      "formId": "BUERGERGELD_KDU",
      "deadline": "Before moving.",
      "documents": [
        "RENTAL_CONTRACT"
      ]
    },
    {
      "id": "wohngeld",
      "name": "Wohngeld (housing benefit)",
      "what": "Rent subsidy if you are not on Bürgergeld and rent eats too much of your income.",
      "authorityId": "wohngeldstelle",
      "apply": "paper",
      "deadline": "Starts in the month of application.",
      "documents": [
        "ID_CARD",
        "REGISTRATION_CERTIFICATE",
        "RENTAL_CONTRACT",
        "INCOME_PROOF"
      ]
    },
    {
      "id": "alg1",
      "name": "Unemployment benefit I",
      "what": "If you worked with insurance for at least 12 of the last 30 months.",
      "authorityId": "agentur_fuer_arbeit",
      "apply": "online",
      "portalUrl": "https://www.arbeitsagentur.de",
      "deadline": "Register as unemployed by the first day without work; register as job-seeking 3 months before the contract ends.",
      "documents": [
        "ID_CARD",
        "EMPLOYMENT_TERMINATION",
        "BANK_DETAILS"
      ]
    },
    {
      "id": "krankengeld",
      "name": "Sickness benefit",
      "what": "From the 7th week of illness the health insurer pays instead of the employer.",
      "authorityId": "krankenkasse",
      "apply": "paper",
      "deadline": "Submit sick notes without gaps."
    },
    {
      "id": "pflegegrad",
      "name": "Care level (Pflegegrad)",
      "what": "When someone permanently needs help in daily life. An informal request to the care fund is enough.",
      "authorityId": "pflegekasse",
      "apply": "paper",
      "deadline": "Benefits from the month of application – call first, then wait for the assessment.",
      "documents": [
        "MEDICAL_REPORTS"
      ]
    },
    {
      "id": "sba",
      "name": "Disability card",
      "what": "Compensations for a permanent impairment: job protection, extra leave, tax.",
      "authorityId": "versorgungsamt",
      "apply": "paper",
      "documents": [
        "MEDICAL_REPORTS",
        "ID_CARD"
      ]
    },
    {
      "id": "uvg",
      "name": "Advance maintenance payment",
      "what": "When the other parent pays no or too little maintenance. For single parents.",
      "authorityId": "jugendamt",
      "apply": "paper",
      "deadline": "Only 1 month retroactively.",
      "documents": [
        "BIRTH_CERTIFICATE",
        "ID_CARD",
        "REGISTRATION_CERTIFICATE"
      ]
    },
    {
      "id": "grusi",
      "name": "Basic income support in old age",
      "what": "When the pension is not enough to live on. Children usually don't have to pay anything back.",
      "authorityId": "sozialamt",
      "apply": "paper",
      "deadline": "Starts in the month of application.",
      "documents": [
        "ID_CARD",
        "RENTAL_CONTRACT",
        "BANK_STATEMENTS",
        "INCOME_PROOF"
      ]
    },
    {
      "id": "rente",
      "name": "Old-age pension",
      "what": "From the statutory retirement age, earlier with deductions. It does not come automatically – you must apply.",
      "authorityId": "rentenversicherung",
      "apply": "online",
      "portalUrl": "https://www.deutsche-rentenversicherung.de",
      "deadline": "3 months before the pension starts.",
      "documents": [
        "ID_CARD",
        "BANK_DETAILS"
      ]
    }
  ],
